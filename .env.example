# ==============================================================================
# Lingua Canvas - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=8080
SERVER_PORT=8080
HOST=0.0.0.0

# Database Persistence (PostgreSQL)
DATABASE_URL=postgres://lingua:lingua_pass@localhost:5432/lingua_canvas

# Distributed Cache & Session Store (Redis)
REDIS_URL=redis://localhost:6379

# Local AI Engine (Llama.cpp OpenAI-compatible API)
AI_PROVIDER=llama_cpp
AI_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
AI_MODEL=llama-3.2-3b-instruct
AI_TIMEOUT_SECS=15
AI_FALLBACK_ENABLED=true

# Logging & Observability
RUST_LOG=info,server=debug
