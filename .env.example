# ==============================================================================
# Lingua Canvas - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=8080
SERVER_PORT=8080
HOST=0.0.0.0

# Database Persistence (PostgreSQL)
DATABASE_URL=postgres://lingua:lingua_pass@localhost:5432/lingua_canvas

# Distributed Cache & Session Store (Redis)
REDIS_URL=redis://localhost:6379

# Local AI Engine (Ollama / Local LLM)
AI_ENDPOINT=http://127.0.0.1:11434/api/generate
AI_MODEL=qwen2.5:3b

# Logging & Observability
RUST_LOG=info,server=debug
