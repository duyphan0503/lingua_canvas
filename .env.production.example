# ==============================================================================
# Lingua Canvas - Production Environment Guidance
# WARNING: Generate strong unique passwords and secrets for production deployment.
# ==============================================================================

# Server Network Configuration
PORT=8080
SERVER_PORT=8080
HOST=0.0.0.0

# Database Persistence (Managed PostgreSQL instance with SSL)
DATABASE_URL=postgres://app_user:REPLACE_WITH_SECURE_PASSWORD@db-prod.internal:5432/lingua_canvas_prod?sslmode=require

# Distributed Cache & Session Store (Managed Redis cluster with TLS/AUTH)
REDIS_URL=rediss://:REPLACE_WITH_REDIS_PASSWORD@redis-prod.internal:6379

# AI Inference Service (Production LLM Gateway)
AI_ENDPOINT=https://ai-gateway.internal/api/generate
AI_MODEL=qwen2.5:3b

# Logging & Observability (Structured JSON logging)
RUST_LOG=info,warn
