# ==============================================================================
# Lingua Canvas - Staging Container Network Configuration
# ==============================================================================

# Server Network Configuration
PORT=8080
SERVER_PORT=8080
HOST=0.0.0.0

# Database Persistence (Docker Compose network: postgres service)
DATABASE_URL=postgres://lingua:lingua_pass@postgres:5432/lingua_canvas

# Distributed Cache (Docker Compose network: redis service)
REDIS_URL=redis://redis:6379

# Local AI Stub / Service (Docker Compose network: ai-stub service)
AI_ENDPOINT=http://ai-stub:11434/api/generate
AI_MODEL=qwen2.5:3b

# Logging & Observability
RUST_LOG=info,server=info
